# Copy this file to `.env` (no .txt at the end!) and fill in the values.
# `.env` is listed in .gitignore, so it never goes to GitHub.
# Never paste these values into a chat, an email, Basecamp or a commit.

# --- Shared class keys: your instructor gives you these ---
# Claude API key from the class Claude Console workspace (shared credits, spend limit applies)
ANTHROPIC_API_KEY=
# Jev (System 1 classifier)
JEV_API_KEY=

# --- Your own keys: you create these on setup night ---
# Turso: app.turso.tech -> your database -> "Connect" (URL starts with libsql://)
TURSO_DATABASE_URL=
# Turso: same page -> "Create token"
TURSO_AUTH_TOKEN=
# GitHub fine-grained token: read-only "Contents" on THIS repo only (the dashboard reads data with it)
GH_DATA_TOKEN=
# GitHub fine-grained token: "Actions" read and write on THIS repo only (Release / Reject buttons)
GH_REVIEW_TOKEN=
# A passcode you make up; only someone who knows it can press Release / Reject
REVIEWER_PASSCODE=

# --- Settings (safe defaults; change only if your instructor says so) ---
CLAUDE_MODEL=claude-haiku-5-5
# Stop calling Claude after this many tokens in one run, or in one day
MAX_TOKENS_PER_RUN=200000
MAX_TOKENS_PER_DAY=1000000
# How many minutes a demo run lasts (one import per minute)
DEMO_MINUTES=15
